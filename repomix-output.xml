                <h2 className="text-base font-semibold text-stone-800">Mi Fonoteca</h2>
                <p className="text-xs text-stone-400">{audioLibrary.length} meditaciones publicadas</p>
              </div>
              <button
                onClick={() => setShowUploadModal(true)}
