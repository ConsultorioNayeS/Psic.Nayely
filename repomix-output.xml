import React from 'react';
import { ArrowLeft, Sparkles, Trophy, Heart, Calendar, CheckCircle2 } from 'lucide-react';

export default function InnerGardenModal({ 
  tasksCount = 0, 
  victoriesCount = 0, 
  sessionsCount = 1,
  onClose 
