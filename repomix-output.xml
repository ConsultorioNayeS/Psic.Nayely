                      {v.tag}
                    </span>
                    <span className="text-stone-400">{v.date}</span>
                  </div>
                  <p className="text-xs text-stone-800 font-medium leading-relaxed">
                    {v.text}
                  </p>
                </div>
              </div>
            ))}
          </div>

        </div>

      </div>
    </div>
  );
}
