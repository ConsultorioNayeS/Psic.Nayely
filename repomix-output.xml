import React, { useState } from 'react';
import { X, Sparkles, BookOpen, Plus, ArrowLeft, Heart, Quote } from 'lucide-react';

export default function EpiphanyVaultModal({ 
  epiphanies = [], 
  onAddEpiphany, 
  onClose,
