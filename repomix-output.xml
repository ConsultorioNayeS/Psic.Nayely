                <Plus className="w-4 h-4" /> Subir Audio
              </button>
            </div>

            <div className="flex gap-1.5 overflow-x-auto pb-1 no-scrollbar">
              {['Todos', 'Ansiedad', 'Insomnio', 'Autoestima', 'Respiración'].map(cat => (
                <button
